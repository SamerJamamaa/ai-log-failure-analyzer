# Streamlit Community Cloud reads secrets from its own dashboard (App
# settings -> Secrets), not from .env. This file is a template showing the
# format to paste there — never commit a real secrets.toml (it's gitignored).
#
# Set ONE of these. If neither is set, the deployed app runs in offline
# (rule-based) analysis mode — safe default for a public link, since it
# costs nothing and needs no key from you or your visitors.
#
# ANTHROPIC_API_KEY = "sk-ant-..."
# OPENAI_API_KEY = "sk-..."
